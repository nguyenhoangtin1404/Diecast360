# Database Connection
# PostgreSQL (Local - default for development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diecast360
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/diecast360

# PostgreSQL (Neon - production template)
# Runtime (pooling)
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Prisma migrate/introspect (direct, no pooler)
# DIRECT_URL=postgresql://neondb_owner:your_password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT Configuration
JWT_SECRET=change-me-to-random-32-char-jwt-secret
JWT_ALLOW_AUTHORIZATION_BEARER=true
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
MAX_SPINNER_FRAMES=48
ALLOWED_MIME=image/jpeg,image/png,image/webp
# STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# Server Configuration
NODE_ENV=development
PORT=3000
# HOST=0.0.0.0
# TRUST_PROXY=1   # Proxy hops before app: 1=Nginx/CF single hop, 2=CDN+LB, 0=no proxy (dev direct)
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=100

# Public URL
# Used for CORS in backend and generation of links
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=
PUBLIC_BASE_URL=http://localhost:5173
# API origin for signed media URLs (/api/v1/media). Backend defaults to http://localhost:3000 if unset.
# BACKEND_URL=https://your-api-host.example.com
CORS_ALLOW_LAN=false
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL_MS=604800000

# CAPTCHA (Optional - recommended for production)
# Providers: cloudflare (Turnstile) or google (reCAPTCHA v3)
# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
# Google reCAPTCHA v3:  https://www.google.com/recaptcha/admin
# CAPTCHA_ENABLED=false
# CAPTCHA_PROVIDER=cloudflare
# CAPTCHA_SECRET_KEY=
# CAPTCHA_MIN_SCORE=0.5   # Only for Google reCAPTCHA v3 (0.0–1.0, default 0.5)

# Frontend Configuration
# Used during build time for frontend
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_ADMIN_SEMANTIC_SEARCH_ENABLED=false
VITE_PUBLIC_PREORDER_SHOP_ID=
VITE_PUBLIC_CATALOG_SHOP_ID=
VITE_MAX_SPINNER_FRAMES=48
# CAPTCHA frontend (must match CAPTCHA_PROVIDER on backend)
# VITE_CAPTCHA_ENABLED=false   # Must be true only when backend CAPTCHA_ENABLED=true
# VITE_CAPTCHA_PROVIDER=cloudflare
# VITE_CAPTCHA_SITE_KEY=

# Cookie Security Settings
# IMPORTANT: Change COOKIE_SECRET in production!
COOKIE_SECRET=change-me-to-random-32-char-cookie-secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# AI Configuration (Optional but recommended)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vector Database (Pinecone) - Optional for search
# Get key from: https://app.pinecone.io/
PINECONE_API_KEY=
PINECONE_INDEX=diecast360

# Facebook Graph API (Optional - needed for automated publish)
# Get Page ID from: Facebook Page > About > Page ID
# Get Page Access Token from: https://developers.facebook.com/tools/explorer/
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v21.0
